{
  "manifest_version": 3,
  "name": "VoxShield Check",
  "version": "0.4.0",
  "description": "Check suspicious media where you find it, before you act on it. Get a verdict, the evidence behind it, and what the result cannot tell you.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
