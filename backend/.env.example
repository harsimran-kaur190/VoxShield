VOXSHIELD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VOXSHIELD_MAX_UPLOAD_MB=25
VOXSHIELD_MAX_DURATION_SECONDS=600
VOXSHIELD_MIN_DURATION_SECONDS=1

# Load both models at startup (in parallel) instead of on the first request. Set false for quick UI-only work.
VOXSHIELD_PRELOAD_MODELS=true

# Speech-to-text (faster-whisper). Try base for speed, small for accuracy.
VOXSHIELD_WHISPER_MODEL_SIZE=small
VOXSHIELD_WHISPER_COMPUTE_TYPE=int8
VOXSHIELD_WHISPER_DEVICE=cpu
# Pin the transcription language for every request (it then counts as selected, with no detection score).
# Normally leave unset: clients choose per request with the optional `language` field (auto, en, hi, pa).
# VOXSHIELD_WHISPER_LANGUAGE=en

# Voice authenticity classifier (Hugging Face model id; labels are mapped by name)
# Default: nii-yamagishilab/mms-300m-anti-deepfake (CC BY-NC-SA 4.0, non-commercial). The earlier Apache-2.0 model,
# Gustking/wav2vec2-large-xlsr-deepfake-audio-classification, still works here (set its revision too).
VOXSHIELD_VOICE_MODEL_ID=nii-yamagishilab/mms-300m-anti-deepfake
VOXSHIELD_VOICE_DEVICE=cpu

# Concurrency and decoding
VOXSHIELD_MAX_CONCURRENT_ANALYSES=4
# VOXSHIELD_WHISPER_BEAM_SIZE=5   # 1 is faster but can change the transcript

# Scam-intent detector: "nli" (zero-shot language model, default) or "rules" (transparent regular expressions).
# The two are never combined. If the "nli" model cannot load, the scam assessment is unavailable; it does not fall back to rules.
VOXSHIELD_SCAM_DETECTOR=nli
# VOXSHIELD_SCAM_MODEL_ID=MoritzLaurer/deberta-v3-base-zeroshot-v2.0   # revision is pinned in config.py
# Entailment-score cut-offs chosen on a small synthetic development set. They are not calibrated probabilities.
# VOXSHIELD_SCAM_NLI_THRESHOLD=0.92
# VOXSHIELD_SCAM_NLI_UNCERTAIN_THRESHOLD=0.30
# VOXSHIELD_SCAM_NLI_REPORTED_THRESHOLD=0.50
# Protective-advice handling and narrated-speech bar (heuristics from a small synthetic set; not calibrated):
# VOXSHIELD_SCAM_NLI_PROTECTIVE_THRESHOLD=0.90
# VOXSHIELD_SCAM_NLI_PROTECTIVE_STRICT_THRESHOLD=0.95
# VOXSHIELD_SCAM_NLI_REPORTED_FINDING_THRESHOLD=0.80
# Used only to make a payment finding uncertain when the grammar does not show who sends the money (never to hide a request):
# VOXSHIELD_SCAM_NLI_SENDER_THRESHOLD=0.85
# VOXSHIELD_SCAM_MAX_PAIRS=5400

# ---- Live calls (browser-to-browser calls analysed while they happen) ----
# Rooms are kept in this process's memory: run ONE API worker when calls are used.
# VOXSHIELD_CALL_MAX_ROOMS=200
# VOXSHIELD_CALL_MAX_ROOMS_PER_CLIENT=10        # empty rooms one client address may hold; rooms in use never count
# VOXSHIELD_CALL_ROOM_IDLE_SECONDS=600          # empty or never-joined rooms are removed after this
# VOXSHIELD_CALL_RECONNECT_GRACE_SECONDS=20     # a dropped participant keeps their place this long
# Each analysis reads the last WINDOW seconds of the other person's audio, after STEP seconds of new audio.
# VOXSHIELD_CALL_ANALYSIS_WINDOW_SECONDS=12
# VOXSHIELD_CALL_ANALYSIS_STEP_SECONDS=5
# VOXSHIELD_CALL_SILENCE_RMS=0.004              # quieter windows are not sent to the models
# VOXSHIELD_CALL_MAX_FRAME_SECONDS=2            # largest audio frame accepted from a browser
# VOXSHIELD_CALL_MAX_AHEAD_SECONDS=8            # largest burst above real time a browser may send (after a stall)
# VOXSHIELD_CALL_ANALYSIS_DELAY_SECONDS=20      # after this, a running analysis is shown as "Analysis delayed"
# VOXSHIELD_CALL_ALERT_COOLDOWN_SECONDS=45      # the same tactic is not alerted again sooner, unless the risk rises
# ICE servers given to call participants. STUN finds a direct path; TURN relays audio when none exists
# (strict NAT, many corporate and mobile networks). Without TURN, some pairs of networks cannot connect.
# VOXSHIELD_CALL_STUN_URLS=["stun:stun.l.google.com:19302"]
# VOXSHIELD_TURN_URLS=["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"]
# Shared secret of a coturn server (use-auth-secret / static-auth-secret). Short-lived credentials are derived from it
# per participant; the secret itself is never sent to browsers. Keep it out of version control.
# VOXSHIELD_TURN_SECRET=
# VOXSHIELD_TURN_CREDENTIAL_TTL_SECONDS=3600

# ---- Production ----
# Origins allowed to call the API from a browser. List your web app's address(es); add a pattern for preview URLs if needed.
# VOXSHIELD_CORS_ORIGINS=["https://app.example.com"]
# VOXSHIELD_CORS_ORIGIN_REGEX=https://voxshield-[a-z0-9-]+\.vercel\.app
# The VoxShield Check browser extension calls the API from a chrome-extension:// origin. Set false to refuse it.
# VOXSHIELD_CORS_ALLOW_EXTENSIONS=true
# Turn the interactive API docs off on a public server.
# VOXSHIELD_DOCS_ENABLED=false
# Requests per client address per minute on the upload and analysis endpoints (0 = no limit).
# VOXSHIELD_RATE_LIMIT_PER_MINUTE=20
# Behind a reverse proxy, list its address so the real client address is used for rate limiting (uvicorn reads this).
# FORWARDED_ALLOW_IPS=10.0.0.5
# After scripts/download_models.py has run, the server can start with no network access.
# HF_HUB_OFFLINE=1

# ---- DeepTruth (image / audio / video deepfake analysis at /deeptruth) ----
# Upload limit for DeepTruth only; VoxShield's audio routes keep VOXSHIELD_MAX_UPLOAD_MB.
# VOXSHIELD_DEEPTRUTH_MAX_UPLOAD_MB=100
# Video: frames per second sampled for the face track, how much of a long video is checked frame by frame, and how
# many frames go to the image classifiers. The audio track is always checked in full (up to MAX_DURATION_SECONDS).
# VOXSHIELD_VIDEO_SAMPLE_FPS=10
# VOXSHIELD_VIDEO_MAX_ANALYZED_SECONDS=60
# VOXSHIELD_VIDEO_CLASSIFIER_FRAMES=16
